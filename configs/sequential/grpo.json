{
  "experiment_name": "sequential_llama",
  "num_cycles": 1,
  "model": {
    "name": "meta-llama/Llama-3.2-3B-Instruct",
    "max_new_tokens": 1024
  },
  "vllm": {
    "host": "localhost",
    "port": 8000,
    "group_port": 51216,
    "connection_timeout": 120.0,
    "gpu_memory_utilization": 0.9
  },
  "cuda_devices": {
    "train": "0,1,2",
    "rollout": "3"
  },
  "seed": 42,
  "tasks": [
    {
      "name": "countdown",
      "type": "countdown",
      "train_size": 200,
      "test_size": 2000,
      "batch_size": 21,
      "total_forward_passes": 40000,
      "max_new_tokens": 1024,
      "K": 8,
      "kl_coef": 0.0,
      "ppo_clip_range": 0.2,
      "use_dr_grpo": false,
      "lr": 0.000003,
      "scheduler_type": "linear",
      "warmup_ratio": 0.0,
      "train_micro_batch_size": 2,
      "infer_micro_batch_size": 2
    },
    {
      "name": "math",
      "type": "math",
      "train_size": 200,
      "test_size": 500,
      "stratify_by_level": true,
      "batch_size": 21,
      "total_forward_passes": 40000,
      "max_new_tokens": 1024,
      "K": 8,
      "kl_coef": 0.0,
      "ppo_clip_range": 0.2,
      "use_dr_grpo": false,
      "lr": 0.000003,
      "scheduler_type": "linear",
      "warmup_ratio": 0.0,
      "train_micro_batch_size": 2,
      "infer_micro_batch_size": 2
    },
    {
      "name": "sciknoweval_chemistry",
      "type": "sciknoweval_chemistry",
      "train_size": 200,
      "test_size": 2000,
      "batch_size": 21,
      "total_forward_passes": 40000,
      "max_new_tokens": 1024,
      "K": 8,
      "kl_coef": 0.0,
      "ppo_clip_range": 0.2,
      "use_dr_grpo": false,
      "lr": 0.000003,
      "scheduler_type": "linear",
      "warmup_ratio": 0.0,
      "train_micro_batch_size": 2,
      "infer_micro_batch_size": 2
    },
    {
      "name": "boolq",
      "type": "boolq",
      "train_size": 200,
      "test_size": 2000,
      "batch_size": 21,
      "total_forward_passes": 40000,
      "max_new_tokens": 1024,
      "K": 8,
      "kl_coef": 0.0,
      "ppo_clip_range": 0.2,
      "use_dr_grpo": false,
      "lr": 0.000003,
      "scheduler_type": "linear",
      "warmup_ratio": 0.0,
      "train_micro_batch_size": 2,
      "infer_micro_batch_size": 2
    }
  ],
  "grpo_hyperparameters": {
    "K": 8,
    "use_dr_grpo": false,
    "ppo_clip_range": 0.2,
    "kl_coef": 0.0,
    "track_kl": true,
    "grad_accum_steps": 1,
    "train_micro_batch_size": 1,
    "infer_micro_batch_size": 1
  },
  "optimizer": {
    "type": "adamw",
    "lr": 0.00001,
    "weight_decay": 0.0,
    "max_grad_norm": 1.0
  },
  "scheduler": {
    "type": "linear",
    "warmup_ratio": 0.0
  },
  "debug": {
    "print_every_n_steps": 1,
    "num_samples_to_print": 8
  }
}
